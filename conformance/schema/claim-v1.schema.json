{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Version-bound conformance claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "release",
    "implementation_commit",
    "reference",
    "suite",
    "evidence",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "implementation_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest",
        "applicability"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "applicability": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "commit"
      ],
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "run_id",
          "timestamp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "status": {
      "enum": [
        "DEMONSTRATED",
        "PARTIAL_EVIDENCE",
        "GAP",
        "NOT_DEMONSTRATED",
        "NOT_APPLICABLE",
        "NOT_CLAIMED"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
